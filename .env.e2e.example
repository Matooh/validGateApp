# Copia este archivo como .env.e2e.local. No lo subas al repositorio.
PLAYWRIGHT_BASE_URL=http://localhost:3000
E2E_START_LOCAL_SERVER=true

# Proyecto Supabase de testing. La service role se usa solo para preparar
# y restablecer registros identificados con E2E_NAMESPACE.
E2E_SUPABASE_URL=https://PROJECT_REF.supabase.co
E2E_SUPABASE_SERVICE_ROLE_KEY=
E2E_ALLOW_REMOTE_MUTATIONS=false
E2E_NAMESPACE=validgate-e2e
E2E_EMAIL_MARKER=e2e

# Usa cuentas ficticias. Todos los correos deben contener E2E_EMAIL_MARKER.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=
E2E_PORTERIA_EMAIL=
E2E_PORTERIA_PASSWORD=
E2E_DOCENTE_EMAIL=
E2E_DOCENTE_PASSWORD=
E2E_APODERADO_EMAIL=
E2E_APODERADO_PASSWORD=
E2E_ESTUDIANTE_EMAIL=
E2E_ESTUDIANTE_PASSWORD=

# Metadatos opcionales que aparecerán en el reporte PDF.
E2E_ENVIRONMENT_NAME=Supabase testing
E2E_BUILD_ID=ejecucion-local

# Cuenta estable de demostración. El smoke no la crea ni restablece y nunca usa
# la service role. Puede coincidir con una cuenta ficticia ya preparada.
DEMO_ADMIN_EMAIL=
DEMO_ADMIN_PASSWORD=
